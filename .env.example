NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/halal-installments

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption key for sensitive fields (passport data etc.)
ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Super admin seed
SUPER_ADMIN_EMAIL=admin@halal-crm.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
